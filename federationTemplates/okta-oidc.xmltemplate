        <!-- Okta OIDC federation -->
        <ClaimsProvider>
            <Domain>{Settings:FederationPartner-{{NUMBER}}-TenantName}</Domain>
            <DisplayName>{{DISPLAY_NAME}}</DisplayName>
            <TechnicalProfiles>
                <TechnicalProfile Id="Step-16-FederationPartner-{Settings:FederationPartner-{{NUMBER}}-TechProfileName}">
                    <DisplayName>Login with {{DISPLAY_NAME}} (OIDC)</DisplayName>
                    <Description>Login with {{DISPLAY_NAME}} (OIDC)</Description>
                    <Protocol Name="OpenIdConnect" />
                    <OutputTokenFormat>JWT</OutputTokenFormat>
                    <Metadata>
                        <Item Key="METADATA">{Settings:FederationPartner-{{NUMBER}}-MetadataUrl}</Item>
                        <Item Key="ProviderName">{Settings:FederationPartner-{{NUMBER}}-ProviderName}</Item>
                        <Item Key="client_id">{Settings:FederationPartner-{{NUMBER}}-ClientId}</Item>
                        <Item Key="IdTokenAudience">{Settings:FederationPartner-{{NUMBER}}-ClientId}</Item>
                        <Item Key="UsePolicyInRedirectUri">false</Item>
                        <Item Key="resource">https://graph.windows.net</Item>
                        <Item Key="response_types">code</Item>
                        <Item Key="issuer">{Settings:FederationPartner-{{NUMBER}}-Issuer}</Item>
                        <Item Key="scope">openid email profile</Item>
                        <Item Key="response_mode">form_post</Item>
                        <Item Key="HttpBinding">POST</Item>
                        <Item Key="ClaimTypeOnWhichToEnable">identityProviders</Item>
                        <Item Key="ClaimValueOnWhichToEnable">{Settings:FederationPartner-{{NUMBER}}-TenantName}</Item>
                    </Metadata>
                    <CryptographicKeys>
                        <Key Id="client_secret" StorageReferenceId="{Settings:FederationPartner-{{NUMBER}}-PolicyKey}" />
                    </CryptographicKeys>
                    <InputClaims>
                        <InputClaim ClaimTypeReferenceId="signInName" PartnerClaimType="login_hint" />
                    </InputClaims>
                    <OutputClaims>
                        <OutputClaim ClaimTypeReferenceId="federationId" PartnerClaimType="unique_name" />
                        <OutputClaim ClaimTypeReferenceId="issuerUserId" PartnerClaimType="oid" />
                        <OutputClaim ClaimTypeReferenceId="tenantId" PartnerClaimType="tid" />
                        <OutputClaim ClaimTypeReferenceId="displayName" PartnerClaimType="name" />
                        <OutputClaim ClaimTypeReferenceId="authenticationSource" DefaultValue="socialIdpAuthentication" AlwaysUseDefaultValue="true" />
                        <OutputClaim ClaimTypeReferenceId="identityProvider" DefaultValue="{Settings:FederationPartner-{{NUMBER}}-TenantName}" AlwaysUseDefaultValue="true" />
                        <OutputClaim ClaimTypeReferenceId="email" />
{{JIT_CLAIMS}}
                    </OutputClaims>
                    <OutputClaimsTransformations>
                        <OutputClaimsTransformation ReferenceId="CreateAlternativeSecurityId" />
                        <OutputClaimsTransformation ReferenceId="CreateSubjectClaimFromAlternativeSecurityId" />
                    </OutputClaimsTransformations>
                    <UseTechnicalProfileForSessionManagement ReferenceId="SM-SocialLogin" />
                    <EnabledForUserJourneys>OnItemExistenceInStringCollectionClaim</EnabledForUserJourneys>
                </TechnicalProfile>
            </TechnicalProfiles>
        </ClaimsProvider>
